<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="ingreso_de_datos_entregable_5_flowgorithm"/>
        <attribute name="authors" value="Vladimir Bastidas"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-11-18 10:44:56 p.&#8239;m."/>
        <attribute name="created" value="VmxhZGltaXIgQmFzdGlkYXM7TEFQVE9QLUlERkxQMjg4OzIwMjUtMTEtMTg7MDY6MzM6NDEgcC7igK9tLjsxMjM4MQ=="/>
        <attribute name="edited" value="VmxhZGltaXIgQmFzdGlkYXM7TEFQVE9QLUlERkxQMjg4OzIwMjUtMTEtMTg7MTA6NDQ6NTYgcC7igK9tLjsxOzEyNDky"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="ideerror, porcentaje, suma" type="Real" array="False" size=""/>
            <declare name="tipidentificacion, nombres, apellidos, genero, direccion" type="String" array="False" size=""/>
            <declare name="a&#241;onacimieto, telefono" type="Integer" array="False" size=""/>
            <declare name="salario" type="Real" array="False" size=""/>
            <assign variable="ideerror" expression="0"/>
            <assign variable="a&#241;onacimieto" expression="0"/>
            <assign variable="porcentaje" expression="0"/>
            <do expression="ideerror = 1">
                <output expression="&quot;Enter the type of identification (CC, PS, CE, CI) -&gt; uppercase&quot;" newline="True"/>
                <input variable="tipidentificacion"/>
                <if expression="tipidentificacion = &quot;CC&quot;">
                    <then>
                        <assign variable="ideerror" expression="0"/>
                    </then>
                    <else>
                        <if expression="tipidentificacion = &quot;PS&quot;">
                            <then>
                                <assign variable="ideerror" expression="0"/>
                            </then>
                            <else>
                                <if expression="tipidentificacion = &quot;CE&quot;">
                                    <then>
                                        <assign variable="ideerror" expression="0"/>
                                    </then>
                                    <else>
                                        <if expression="tipidentificacion = &quot;CI&quot;">
                                            <then>
                                                <assign variable="ideerror" expression="0"/>
                                            </then>
                                            <else>
                                                <output expression="&quot;Error entering the identification type&quot;" newline="True"/>
                                                <assign variable="ideerror" expression="1"/>
                                            </else>
                                        </if>
                                    </else>
                                </if>
                            </else>
                        </if>
                    </else>
                </if>
            </do>
            <output expression="&quot;Please enter your names:&quot;" newline="True"/>
            <input variable="nombres"/>
            <output expression="&quot;Please enter your last name: &quot;" newline="True"/>
            <input variable="apellidos"/>
            <do expression="ideerror = 1">
                <output expression="&quot;Enter your gender type: &quot;" newline="True"/>
                <output expression="&quot;M-(male)&quot;" newline="True"/>
                <output expression="&quot;F-(feminine)&quot;" newline="True"/>
                <input variable="genero"/>
                <if expression="genero = &quot;M&quot;">
                    <then>
                        <assign variable="ideerror" expression="0"/>
                    </then>
                    <else>
                        <if expression="genero = &quot;F&quot;">
                            <then>
                                <assign variable="ideerror" expression="0"/>
                            </then>
                            <else>
                                <output expression="&quot;Error entering genre, please try again&quot;" newline="True"/>
                                <assign variable="ideerror" expression="1"/>
                            </else>
                        </if>
                    </else>
                </if>
            </do>
            <do expression="ideerror = 1">
                <output expression="&quot;Enter your year of birth: &quot;" newline="True"/>
                <input variable="a&#241;onacimieto"/>
                <if expression="a&#241;onacimiento &lt; 2025">
                    <then>
                        <if expression="a&#241;onacimiento &gt; 0">
                            <then>
                                <assign variable="ideerror" expression="0"/>
                            </then>
                            <else>
                                <output expression="&quot;Invalid date of birth&quot;" newline="True"/>
                                <assign variable="ideerror" expression="1"/>
                            </else>
                        </if>
                    </then>
                    <else>
                        <output expression="&quot;Invalid date of birth&quot;" newline="True"/>
                        <assign variable="ideerror" expression="1"/>
                    </else>
                </if>
            </do>
            <output expression="&quot;Enter your address: &quot;" newline="True"/>
            <input variable="direccion"/>
            <output expression="&quot;Enter your phone number: &quot;" newline="True"/>
            <input variable="telefono"/>
            <output expression="&quot;ingrese su salario: &quot;" newline="True"/>
            <input variable="salario"/>
            <if expression="salario &lt; 1200000">
                <then>
                    <if expression="genero = &quot;M&quot;">
                        <then>
                            <assign variable="porcentaje" expression="salario * 0.08"/>
                            <assign variable="suma" expression="porcentaje + salario"/>
                        </then>
                        <else>
                            <assign variable="porcentaje" expression="salario * 0.1"/>
                            <assign variable="suma" expression="porcentaje + salario"/>
                        </else>
                    </if>
                </then>
                <else>
                    <if expression="salario &gt;= 2000000">
                        <then>
                            <if expression="genero = &quot;M&quot;">
                                <then>
                                    <assign variable="porcentaje" expression="salario * 0.025"/>
                                    <assign variable="suma" expression="porcentaje + salario"/>
                                </then>
                                <else>
                                    <assign variable="porcentaje" expression="salario * 0.03"/>
                                    <assign variable="suma" expression="porcentaje + salario"/>
                                </else>
                            </if>
                        </then>
                        <else>
                            <assign variable="porcentaje" expression="salario * 0.05"/>
                            <assign variable="suma" expression="porcentaje + salario"/>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;se realizar&#225; un aumento de: &quot;&amp; porcentaje &amp; &quot; en su salario &quot;" newline="True"/>
            <output expression="&quot;salario total: &quot; &amp; suma" newline="True"/>
        </body>
    </function>
</flowgorithm>
