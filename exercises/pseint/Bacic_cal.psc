// Algorit description:
// Basic cal v1
// get two number 
// add,subs, mut, div,
//print results
Proceso Basic_cal 
	// 1.Define vars and/or const
	Definir suma, resta, multipli, divi, num1, num2 Como Real;
	// 2. 
	Escribir 'ingrese primer numero';
	Leer num1;
	Escribir 'ingrese segundo numero';
	//3. proces
	leer num2;
	suma <- num1 + num2 ;
	resta <- num1 - num2 ;
	multipli <- num1 * num2 ;
	divi <- num1 / num2 ;
	// 4. outputs
	Escribir 'el resultado de la suma es:',suma;
	Escribir 'el resultado de la resta es:',resta;
	Escribir 'el resultado de la multiplicacion es:',multipli;
	Escribir 'el resultado de la divicion es:',divi;
	
FinProceso
