<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="positivo_negativo_paroin_flowgorithm"/>
        <attribute name="authors" value="Vladimir Bastidas"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-11-15 04:51:46 p.&#8239;m."/>
        <attribute name="created" value="VmxhZGltaXIgQmFzdGlkYXM7TEFQVE9QLUlERkxQMjg4OzIwMjUtMTEtMTU7MDQ6NDI6NDIgcC7igK9tLjsxMjM3Nw=="/>
        <attribute name="edited" value="VmxhZGltaXIgQmFzdGlkYXM7TEFQVE9QLUlERkxQMjg4OzIwMjUtMTEtMTU7MDQ6NDU6MTYgcC7igK9tLjs0O1ZsYWRpbWlyIEJhc3RpZGFzO0xBUFRPUC1JREZMUDI4ODsyMDI1LTExLTE1OzA0OjMwOjQwIHAu4oCvbS47cGFyX29faW1wYXJfcmV0bzJfZmxvd2dvcml0aG0uZnByZzsyODUwNA=="/>
        <attribute name="edited" value="VmxhZGltaXIgQmFzdGlkYXM7TEFQVE9QLUlERkxQMjg4OzIwMjUtMTEtMTU7MDQ6NTE6NDYgcC7igK9tLjsxOzEyNDg5"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="num1, resto" type="Integer" array="False" size=""/>
            <output expression="&quot;__--Welcome, please enter a number (positive or negative)--__&quot;" newline="True"/>
            <input variable="num1"/>
            <assign variable="resto" expression="num1 mod 2"/>
            <if expression="num1 &gt;= 0">
                <then>
                    <output expression="&quot;the number entered_&quot; &amp; num1 &amp; &quot;: is positive&quot;" newline="True"/>
                    <if expression="resto = 0">
                        <then>
                            <output expression="&quot;The remainder of the division is _&quot; &amp; resto &amp; &quot;: the number is even&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;The remainder of the division is_&quot; &amp; resto &amp; &quot;: the number is odd&quot;" newline="True"/>
                        </else>
                    </if>
                </then>
                <else>
                    <output expression="&quot;the number entered_&quot; &amp; num1 &amp; &quot;: is negative&quot;" newline="True"/>
                    <if expression="resto = 0">
                        <then>
                            <output expression="&quot;The remainder of the division is _&quot; &amp; resto &amp; &quot;: the number is even&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;The remainder of the division is _&quot; &amp; resto &amp; &quot;: the number is odd&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
